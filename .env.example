# Local stack configuration. Copy to .env (never commit .env):
#   cp env.example .env
# Values marked change-me are secrets: pick your own.

# --- Airflow ---
# On Linux/WSL set this to the output of `id -u` so files written to the repo are yours
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_SECRET_KEY=change-me-to-a-long-random-string
# host port for the Airflow UI (change if 8080 is taken)
AIRFLOW_HOST_PORT=8080

# --- Postgres: Airflow metadata DB + local warehouse (Redshift stand-in) ---
POSTGRES_USER=fincore
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5433

# --- S3 (LocalStack accepts any credentials) ---
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
FINCORE_RAW_BUCKET=fincore-raw
FINCORE_PROCESSED_BUCKET=fincore-processed

# --- Sample data loaded by airflow-init and etl-local ---
FINCORE_DEMO_TRADE_DATE=2026-10-26
FINCORE_DEMO_TRADE_COUNT=5000

# --- Pipeline tuning ---
# how long the S3 sensors wait for a source before aborting the run (spec: 240)
FINCORE_SENSOR_TIMEOUT_MINUTES=240
